{
  "name": "@open-cinema/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./queries": "./src/queries/index.ts",
    "./mutations": "./src/mutations/index.ts",
    "./durable": "./src/durable/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "prisma generate",
    "validate": "prisma validate",
    "migrate:local": "wrangler d1 migrations apply open-cinema --local --config ../../apps/jobs/wrangler.jsonc --persist-to ../../.wrangler/state"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prisma/adapter-d1": "7.10.1",
    "@open-cinema/contracts": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "wrangler": "4.151.1"
  }
}
