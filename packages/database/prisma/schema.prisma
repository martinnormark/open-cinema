generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String          @id
  createdAt DateTime        @default(now())
  workflows Workflow[]
  jobs      GenerationJob[]
  projects  Project[]
  elements  Element[]
  media     MediaAsset[]
  revisions Revision[]
  sequences Sequence[]
  recipes   Recipe[]
}

model Workflow {
  id        String   @id
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  name      String
  version   Int      @default(1)
  graph     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
}

model GenerationJob {
  id               String      @id
  ownerId          String
  owner            User        @relation(fields: [ownerId], references: [id])
  state            String
  version          Int
  idempotencyKey   String
  requestHash      String
  workflowSnapshot Json
  inputsSnapshot   Json
  providerJobId    String?
  error            String?
  prompt           String      @default("")
  model            String      @default("FLUX 3 Image Klein")
  workflowKind     String      @default("image.flux")
  projectId        String?
  seed             Int?
  progress         Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  outputs          JobOutput[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
  @@index([ownerId, state])
}

model JobOutput {
  id              String        @id
  jobId           String
  job             GenerationJob @relation(fields: [jobId], references: [id])
  providerAssetId String
  mediaType       String
  r2Key           String?       @unique
  sizeBytes       Int?
  etag            String?
  /// Videos: the poster still and the size and length the browser measured drawing it.
  posterKey       String?
  width           Int?
  height          Int?
  durationMs      Int?

  @@index([jobId])
}

model Project {
  id        String       @id
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id])
  name      String
  direction String       @default("")
  /// The shared look (palette, lighting, lens, texture, pacing) as JSON.
  look      Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  elements  Element[]
  media     MediaAsset[]
  revisions Revision[]
  sequences Sequence[]

  @@index([ownerId, updatedAt])
}

model Element {
  id          String             @id
  ownerId     String
  owner       User               @relation(fields: [ownerId], references: [id])
  projectId   String?
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type        String
  name        String
  handle      String
  description String             @default("")
  version     Int                @default(1)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  references  ElementReference[]
  states      ElementState[]

  @@unique([ownerId, handle])
  @@index([ownerId, type, updatedAt])
}

model ElementState {
  id          String             @id
  elementId   String
  element     Element            @relation(fields: [elementId], references: [id], onDelete: Cascade)
  name        String
  description String             @default("")
  /// What the state changes (emotion, wardrobe, weather, ...); one per kind combines.
  kind        String             @default("other")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  references  ElementReference[]

  @@unique([elementId, name])
}

/// Asset refs are stored as typed columns, not foreign keys: job outputs are
/// projected to SQLite asynchronously, so ownership is checked in mutations.
model ElementReference {
  id           String        @id
  elementId    String
  element      Element       @relation(fields: [elementId], references: [id], onDelete: Cascade)
  stateId      String?
  state        ElementState? @relation(fields: [stateId], references: [id], onDelete: Cascade)
  assetType    String
  mediaAssetId String?
  jobId        String?
  outputId     String?
  status       String
  view         String?
  roles        Json
  note         String        @default("")
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([elementId, status])
  @@index([stateId])
}

model MediaAsset {
  id          String   @id
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  kind        String
  status      String
  mediaType   String
  filename    String
  r2Key       String   @unique
  sizeBytes   Int?
  etag        String?
  width       Int?
  height      Int?
  durationMs  Int?
  fps         Float?
  /// Sample aspect ratio measured at upload; 1 is square pixels.
  pixelAspect Float?
  hasAudio    Boolean?
  /// The poster still; null until one is stored.
  posterKey   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, kind, createdAt])
}

model Revision {
  id               String   @id
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id])
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentRevisionId String?
  sourceType       String
  sourceAssetId    String?
  sourceJobId      String?
  sourceOutputId   String?
  resultJobId      String?
  resultOutputId   String?
  jobId            String?
  workflowKind     String
  intent           String
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@index([jobId])
  @@index([sourceAssetId])
  @@index([sourceJobId, sourceOutputId])
}

/// An idea developed into ordered shots; each shot is approved independently.
model Sequence {
  id        String   @id
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title     String
  idea      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shots     Shot[]

  @@index([ownerId, updatedAt])
  @@index([projectId])
}

model Shot {
  id              String      @id
  sequenceId      String
  sequence        Sequence    @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sortOrder       Int
  title           String
  beat            String      @default("")
  prompt          String      @default("")
  /// Who stands where, which side the camera is on, what the light does.
  staging         String      @default("")
  framing         String
  camera          String
  durationSeconds Int
  continuity      String      @default("fresh")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  takes           ShotTake[]

  @@index([sequenceId, sortOrder])
}

/// Asset columns stay null until the take's job saves an output.
model ShotTake {
  id           String   @id
  shotId       String
  shot         Shot     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  role         String
  origin       String
  status       String
  jobId        String?
  assetType    String?
  mediaAssetId String?
  assetJobId   String?
  outputId     String?
  prompt       String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shotId, role])
  @@index([jobId])
}

/// A saved creative recipe. `spec` is the current template, slots, look and
/// capabilities; `history` keeps earlier versions, newest first.
model Recipe {
  id            String   @id
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
  name          String
  summary       String   @default("")
  spec          Json
  version       Int      @default(1)
  parentId      String?
  coverType     String?
  coverAssetId  String?
  coverJobId    String?
  coverOutputId String?
  history       Json     @default("[]")
  uses          Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ownerId, updatedAt])
}
