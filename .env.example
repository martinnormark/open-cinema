# Docker starts without a key; add one to enable generation.
# This common key is the fallback for both Comfy Router and Comfy Cloud.
COMFY_API_KEY=
# Optional separate credentials; leave blank to use COMFY_API_KEY.
COMFY_ROUTER_API_KEY=
# Character ComfyUI workflows use this key (or COMFY_API_KEY above).
# No separate BFL or language-model key is needed.
COMFY_CLOUD_API_KEY=
MAX_ACTIVE_JOBS=1

# Default: local studio at http://localhost:3000, exposed on loopback only.
AUTH_MODE=local
LOCAL_MVP_ENABLED=true
# A persistent random session secret is created in the data volume if omitted.
# LOCAL_SESSION_SECRET=

# Public hosting: set AUTH_MODE=password and provide a strong password.
# The browser asks for these credentials. This is one shared studio account.
BASIC_AUTH_USER=studio
BASIC_AUTH_PASSWORD=
# Set this to the public HTTPS origin when using a TLS reverse proxy.
APP_ORIGIN=
# Optional provider-fetchable origin. Otherwise media is uploaded to Comfy storage.
MEDIA_PUBLIC_ORIGIN=
# Defaults to the session secret; independent overrides are supported.
# MEDIA_SIGNING_SECRET=

# Every setting supports NAME_FILE=/run/secrets/name. File values win.
# Mount files with Docker --mount or Compose secrets (see docs/deployment.md).
# COMFY_API_KEY_FILE=/run/secrets/comfy_api_key
# BASIC_AUTH_PASSWORD_FILE=/run/secrets/studio_password
