{
  "source": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "source.mp4"
    }
  },
  "source_frames": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "source",
        0
      ]
    }
  },
  "source_size": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "source_frames",
        0
      ]
    }
  },
  "source_length": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(1, ((min(a, 81) - 1) // 8) * 8 + 1)",
      "values.a": [
        "source_size",
        2
      ]
    }
  },
  "source_gen_width": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(64, round(a * min(1, 832 / max(a, b)) / 32) * 32)",
      "values.a": [
        "source_size",
        0
      ],
      "values.b": [
        "source_size",
        1
      ]
    }
  },
  "source_gen_height": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(64, round(b * min(1, 832 / max(a, b)) / 32) * 32)",
      "values.a": [
        "source_size",
        0
      ],
      "values.b": [
        "source_size",
        1
      ]
    }
  },
  "source_clip": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "source_frames",
        0
      ],
      "batch_index": 0,
      "length": [
        "source_length",
        1
      ]
    }
  },
  "source_small": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "source_clip",
        0
