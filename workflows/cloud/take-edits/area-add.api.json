  },
  "wan_sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "wan_model",
        0
      ],
      "positive": [
        "wan_vace",
        0
      ],
      "negative": [
        "wan_vace",
        1
      ],
      "latent_image": [
        "wan_vace",
        2
