  },
  "wan_model": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "wan_unet",
        0
      ],
      "shift": 5
    }
  },
  "wan_clip": {
    "class_type": "CLIPLoader",
    "inputs": {
