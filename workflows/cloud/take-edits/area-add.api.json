      "vae": [
        "wan_vae",
        0
      ],
      "width": [
        "source_gen_width",
        1
      ],
      "height": [
        "source_gen_height",
        1
      ],
      "length": [
        "source_length",
        1
      ],
      "batch_size": 1,
      "strength": 1,
      "control_video": [
        "control",
        0
      ],
      "control_masks": [
        "mask_held",
        0
      ]
