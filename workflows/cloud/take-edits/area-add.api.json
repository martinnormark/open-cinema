  },
  "mask_held": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": [
        "mask_channel",
        0
      ],
      "expand": 20,
      "tapered_corners": true
    }
  },
  "grey": {
    "class_type": "EmptyImage",
    "inputs": {
      "width": [
        "source_gen_width",
        1
      ],
      "height": [
        "source_gen_height",
        1
      ],
      "batch_size": 1,
      "color": 8355711
