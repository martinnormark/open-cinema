      "batch_index": 0,
      "length": 1
    }
  },
  "mask": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "mask.png"
    }
  },
  "mask_small": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "mask",
        0
      ],
      "upscale_method": "area",
      "width": [
        "source_gen_width",
        1
      ],
      "height": [
        "source_gen_height",
        1
      ],
      "crop": "disabled"
    }
  },
  "mask_frames": {
    "class_type": "RepeatImageBatch",
    "inputs": {
      "image": [
        "mask_small",
        0
      ],
      "amount": [
        "source_length",
        1
      ]
    }
  },
  "mask_channel": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": [
        "mask_frames",
        0
