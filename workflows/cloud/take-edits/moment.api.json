  "window_length": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(9, ((min(a, 97) - 1) // 8) * 8 + 1)",
      "values.a": [
        "source_size",
        2
      ]
    }
  },
  "moment_start": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "min(max(1, round(a * b)), c - 2)",
      "values.a": 2,
      "values.b": [
        "source_frames",
        2
      ],
      "values.c": [
        "source_size",
        2
      ]
    }
  },
  "moment_end": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "min(max(d + 1, round(a * b)), c - 1, d + e - 16)",
      "values.a": 3.5,
      "values.b": [
        "source_frames",
        2
      ],
      "values.c": [
        "source_size",
        2
      ],
      "values.d": [
        "moment_start",
        1
      ],
      "values.e": [
        "window_length",
        1
      ]
    }
  },
  "moment_length": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "b - a",
      "values.a": [
        "moment_start",
        1
      ],
      "values.b": [
        "moment_end",
        1
      ]
    }
  },
  "window_start": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(0, min(c - e, (a + b) // 2 - e // 2))",
      "values.a": [
        "moment_start",
        1
      ],
      "values.b": [
        "moment_end",
        1
      ],
      "values.c": [
        "source_size",
        2
      ],
      "values.e": [
        "window_length",
        1
      ]
    }
  },
  "moment_offset": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "a - b",
      "values.a": [
        "moment_start",
        1
      ],
      "values.b": [
        "window_start",
        1
      ]
    }
  },
  "gen_width": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(64, round(a * min(1, 768 / max(a, b)) / 32) * 32)",
      "values.a": [
        "source_size",
        0
      ],
      "values.b": [
        "source_size",
        1
      ]
    }
  },
  "gen_height": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(64, round(b * min(1, 768 / max(a, b)) / 32) * 32)",
      "values.a": [
        "source_size",
        0
      ],
      "values.b": [
        "source_size",
        1
      ]
    }
  },
  "window": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "source_frames",
        0
      ],
      "batch_index": [
        "window_start",
        1
      ],
      "length": [
        "window_length",
        1
      ]
    }
  },
  "window_small": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "window",
