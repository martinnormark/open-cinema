  "key_after_at": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "a + b",
      "values.a": [
        "moment_offset",
        1
      ],
      "values.b": [
        "moment_length",
        1
      ]
    }
  },
  "key_after_far_at": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "min(c - 1, a + b + 3)",
      "values.a": [
        "moment_offset",
        1
      ],
      "values.b": [
        "moment_length",
        1
      ],
      "values.c": [
        "window_length",
        1
      ]
    }
  },
  "key_before_far": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "window_small",
