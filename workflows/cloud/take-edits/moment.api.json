  "switch_start": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(0, a - 3)",
      "values.a": [
        "moment_offset",
        1
      ]
    }
  },
  "switch_length": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "min(c, a + b + 3) - max(0, a - 3)",
      "values.a": [
        "moment_offset",
        1
      ],
      "values.b": [
        "moment_length",
        1
      ],
      "values.c": [
        "window_length",
        1
      ]
    }
  },
  "switch_at": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "a + b",
      "values.a": [
        "window_start",
        1
      ],
      "values.b": [
        "switch_start",
        1
      ]
    }
  },
  "key_before_far_at": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(0, a - 4)",
      "values.a": [
        "moment_offset",
        1
      ]
    }
  },
  "key_before_at": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "a - 1",
      "values.a": [
