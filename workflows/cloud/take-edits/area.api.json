{
  "source": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "source.mp4"
    }
  },
  "source_frames": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "source",
        0
      ]
    }
  },
  "source_size": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "source_frames",
        0
      ]
    }
  },
  "source_length": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(1, ((min(a, 81) - 1) // 8) * 8 + 1)",
      "values.a": [
        "source_size",
        2
      ]
    }
  },
  "source_gen_width": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(64, round(a * min(1, 768 / max(a, b)) / 32) * 32)",
      "values.a": [
        "source_size",
        0
      ],
      "values.b": [
        "source_size",
        1
      ]
    }
  },
  "source_gen_height": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(64, round(b * min(1, 768 / max(a, b)) / 32) * 32)",
      "values.a": [
        "source_size",
        0
      ],
      "values.b": [
        "source_size",
        1
      ]
    }
  },
  "source_clip": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "source_frames",
        0
      ],
      "batch_index": 0,
      "length": [
        "source_length",
        1
      ]
    }
  },
  "source_small": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "source_clip",
        0
      ],
      "upscale_method": "bilinear",
      "width": [
        "source_gen_width",
        1
      ],
      "height": [
        "source_gen_height",
        1
      ],
      "crop": "disabled"
    }
  },
  "source_first": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "source_clip",
        0
      ],
      "batch_index": 0,
      "length": 1
    }
  },
  "mask": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "mask.png"
    }
  },
  "mask_small": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "mask",
        0
      ],
      "upscale_method": "area",
      "width": [
        "source_gen_width",
        1
      ],
      "height": [
        "source_gen_height",
        1
      ],
      "crop": "disabled"
    }
  },
  "mask_small_channel": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": [
        "mask_small",
        0
      ],
      "channel": "red"
    }
  },
  "mask_grown": {
    "class_type": "LTXVDilateVideoMask",
    "inputs": {
      "mask": [
        "mask_small_channel",
        0
      ],
      "spatial_radius": 8,
      "temporal_radius": 0
    }
  },
  "mask_full": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "mask",
        0
      ],
      "upscale_method": "bilinear",
      "width": [
        "source_size",
        0
      ],
      "height": [
        "source_size",
        1
      ],
      "crop": "disabled"
    }
  },
  "mask_full_channel": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": [
        "mask_full",
        0
      ],
      "channel": "red"
    }
  },
  "mask_full_grown": {
    "class_type": "GrowMask",
    "inputs": {
      "mask": [
        "mask_full_channel",
        0
      ],
      "expand": 12,
      "tapered_corners": true
    }
  },
  "mask_full_image": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": [
        "mask_full_grown",
        0
      ]
    }
  },
  "mask_full_soft": {
    "class_type": "ImageBlur",
    "inputs": {
      "image": [
        "mask_full_image",
        0
      ],
      "blur_radius": 12,
      "sigma": 6
    }
  },
  "mask_blend": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": [
        "mask_full_soft",
        0
      ],
      "channel": "red"
    }
  },
  "fill_reference": {
    "class_type": "LTXVInpaintPreprocess",
    "inputs": {
      "images": [
        "source_small",
        0
      ],
      "mask": [
        "mask_grown",
        0
      ]
    }
  },
  "ltx_ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors"
    }
  },
  "ltx_text_encoder": {
    "class_type": "LTXAVTextEncoderLoader",
    "inputs": {
      "text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors",
      "ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors",
      "device": "default"
    }
  },
  "ltx_audio_vae": {
    "class_type": "LTXVAudioVAELoader",
    "inputs": {
      "ckpt_name": "ltx-2.3-22b-distilled-fp8.safetensors"
    }
  },
  "ltx_lora_0": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "ltx_ckpt",
        0
      ],
      "lora_name": "ltx-2.3-22b-ic-lora-in-outpainting-0.9.safetensors",
      "strength_model": 1
    }
  },
  "ltx_positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "ltx_text_encoder",
        0
      ]
    }
  },
  "ltx_negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, out of focus, overexposed, underexposed, low contrast, washed out colors, excessive noise, flickering, distorted proportions, deformed facial features, extra limbs, disfigured hands, watermark, logo, subtitles, text overlay, vignette, dark corners, circular frame, keyhole mask, fisheye",
      "clip": [
        "ltx_text_encoder",
        0
      ]
    }
  },
  "ltx_conditioning": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": [
        "ltx_positive",
        0
      ],
      "negative": [
        "ltx_negative",
        0
      ],
      "frame_rate": [
        "source_frames",
        2
      ]
    }
  },
  "ltx_empty": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": [
        "source_gen_width",
        1
      ],
      "height": [
        "source_gen_height",
        1
      ],
      "length": [
        "source_length",
        1
      ],
      "batch_size": 1
    }
  },
  "ltx_ic_params": {
    "class_type": "GetICLoRAParameters",
    "inputs": {
      "iclora_model": [
        "ltx_lora_0",
        0
      ]
    }
  },
  "ltx_guide": {
    "class_type": "LTXVAddGuide",
    "inputs": {
      "positive": [
        "ltx_conditioning",
        0
      ],
      "negative": [
        "ltx_conditioning",
        1
      ],
      "vae": [
        "ltx_ckpt",
        2
      ],
      "latent": [
        "ltx_empty",
        0
      ],
      "image": [
        "fill_reference",
        0
      ],
      "frame_idx": 0,
      "strength": 1,
      "iclora_parameters": [
        "ltx_ic_params",
        0
      ]
    }
  },
  "ltx_empty_audio": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": {
      "frames_number": [
        "source_length",
        1
      ],
      "frame_rate": [
        "source_frames",
        2
      ],
      "batch_size": 1,
      "audio_vae": [
        "ltx_audio_vae",
        0
      ]
    }
  },
  "ltx_av": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": [
        "ltx_guide",
        2
      ],
      "audio_latent": [
        "ltx_empty_audio",
        0
      ]
    }
  },
  "ltx_noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 20261030
    }
  },
  "ltx_guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": [
        "ltx_lora_0",
        0
      ],
      "positive": [
        "ltx_guide",
        0
      ],
      "negative": [
        "ltx_guide",
        1
      ],
      "cfg": 1
    }
  },
  "ltx_sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler_ancestral"
    }
  },
  "ltx_sigmas": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
    }
  },
  "ltx_sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "ltx_noise",
        0
      ],
      "guider": [
        "ltx_guider",
        0
      ],
      "sampler": [
        "ltx_sampler",
        0
      ],
      "sigmas": [
        "ltx_sigmas",
        0
      ],
      "latent_image": [
        "ltx_av",
        0
      ]
    }
  },
  "ltx_separate": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": [
        "ltx_sample",
        0
      ]
    }
  },
  "ltx_crop": {
    "class_type": "LTXVCropGuides",
    "inputs": {
      "positive": [
        "ltx_guide",
        0
      ],
      "negative": [
        "ltx_guide",
        1
      ],
      "latent": [
        "ltx_separate",
        0
      ]
    }
  },
  "ltx_decode": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "ltx_crop",
        2
      ],
      "vae": [
        "ltx_ckpt",
        2
      ],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "ltx_audio": {
    "class_type": "LTXVAudioVAEDecode",
    "inputs": {
      "samples": [
        "ltx_separate",
        1
      ],
      "audio_vae": [
        "ltx_audio_vae",
        0
      ]
    }
  },
  "generated_full": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "ltx_decode",
        0
      ],
      "upscale_method": "lanczos",
      "width": [
        "source_size",
        0
      ],
      "height": [
        "source_size",
        1
      ],
      "crop": "disabled"
    }
  },
  "result": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "source_clip",
        0
      ],
      "source": [
        "generated_full",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "mask_blend",
        0
      ]
    }
  },
  "save_result_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "result",
        0
      ],
      "fps": [
        "source_frames",
        2
      ],
      "audio": [
        "source_frames",
        1
      ]
    }
  },
  "save_result": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "save_result_video",
        0
      ],
      "filename_prefix": "open_cinema/fill_area",
      "format": "mp4",
      "format.codec": "h264"
    }
  }
}
