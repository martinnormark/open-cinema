{
  "first_frame": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "first-frame.png"
    }
  },
  "first_frame_fit": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "first_frame",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1280,
      "height": 704,
      "crop": "center"
    }
  },
  "ltx_ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "ltx-2-19b-distilled-fp8.safetensors"
    }
  },
  "ltx_text_encoder": {
    "class_type": "LTXAVTextEncoderLoader",
    "inputs": {
      "text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors",
      "ckpt_name": "ltx-2-19b-distilled-fp8.safetensors",
      "device": "default"
    }
  },
  "ltx_audio_vae": {
    "class_type": "LTXVAudioVAELoader",
    "inputs": {
      "ckpt_name": "ltx-2-19b-distilled-fp8.safetensors"
    }
  },
  "ltx_lora_0": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "ltx_ckpt",
        0
      ],
      "lora_name": "ltx-2-19b-lora-camera-control-dolly-right.safetensors",
      "strength_model": 1
    }
  },
  "ltx_positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "A lighthouse keeper in a yellow oilskin coat walks along a wet stone pier at dusk, waves breaking behind him. The camera trucks right.",
      "clip": [
        "ltx_text_encoder",
        0
      ]
    }
  },
  "ltx_negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, out of focus, overexposed, underexposed, low contrast, washed out colors, excessive noise, flickering, distorted proportions, deformed facial features, extra limbs, disfigured hands, watermark, logo, subtitles, text overlay, vignette, dark corners, circular frame, keyhole mask, fisheye",
      "clip": [
        "ltx_text_encoder",
        0
      ]
    }
  },
  "ltx_conditioning": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": [
        "ltx_positive",
        0
      ],
      "negative": [
        "ltx_negative",
        0
      ],
      "frame_rate": 24
    }
  },
  "ltx_empty": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": 1280,
      "height": 704,
      "length": 121,
      "batch_size": 1
    }
  },
  "ltx_first_prep": {
    "class_type": "LTXVPreprocess",
    "inputs": {
      "image": [
        "first_frame_fit",
        0
      ],
      "img_compression": 33
    }
  },
  "ltx_first_frame": {
    "class_type": "LTXVImgToVideoInplace",
    "inputs": {
      "vae": [
        "ltx_ckpt",
        2
      ],
      "image": [
        "ltx_first_prep",
        0
      ],
      "latent": [
        "ltx_empty",
        0
      ],
      "strength": 1,
      "bypass": false
    }
  },
  "ltx_empty_audio": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": {
      "frames_number": 121,
      "frame_rate": 24,
      "batch_size": 1,
      "audio_vae": [
        "ltx_audio_vae",
        0
      ]
    }
  },
  "ltx_av": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": [
        "ltx_first_frame",
        0
      ],
      "audio_latent": [
        "ltx_empty_audio",
        0
      ]
    }
  },
  "ltx_noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 20261030
    }
  },
  "ltx_guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": [
        "ltx_lora_0",
        0
      ],
      "positive": [
        "ltx_conditioning",
        0
      ],
      "negative": [
        "ltx_conditioning",
        1
      ],
      "cfg": 1
    }
  },
  "ltx_sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler_ancestral"
    }
  },
  "ltx_sigmas": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
    }
  },
  "ltx_sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "ltx_noise",
        0
      ],
      "guider": [
        "ltx_guider",
        0
      ],
      "sampler": [
        "ltx_sampler",
        0
      ],
      "sigmas": [
        "ltx_sigmas",
        0
      ],
      "latent_image": [
        "ltx_av",
        0
      ]
    }
  },
  "ltx_separate": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": [
        "ltx_sample",
        0
      ]
    }
  },
  "ltx_crop": {
    "class_type": "LTXVCropGuides",
    "inputs": {
      "positive": [
        "ltx_conditioning",
        0
      ],
      "negative": [
        "ltx_conditioning",
        1
      ],
      "latent": [
        "ltx_separate",
        0
      ]
    }
  },
  "ltx_decode": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "ltx_crop",
        2
      ],
      "vae": [
        "ltx_ckpt",
        2
      ],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "ltx_audio": {
    "class_type": "LTXVAudioVAEDecode",
    "inputs": {
      "samples": [
        "ltx_separate",
        1
      ],
      "audio_vae": [
        "ltx_audio_vae",
        0
      ]
    }
  },
  "save_result_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "ltx_decode",
        0
      ],
      "fps": 24,
      "audio": [
        "ltx_audio",
        0
      ]
    }
  },
  "save_result": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "save_result_video",
        0
      ],
      "filename_prefix": "open_cinema/camera",
      "format": "mp4",
      "format.codec": "h264"
    }
  }
}
