{
  "source": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "source.mp4"
    }
  },
  "source_frames": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "source",
        0
      ]
    }
  },
  "edit": {
    "class_type": "VHS_LoadVideoFFmpeg",
    "inputs": {
      "video": "edit.mp4",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "start_time": 0,
      "format": "None"
    }
  },
  "edit_info": {
    "class_type": "VHS_VideoInfoLoaded",
    "inputs": {
      "video_info": [
        "edit",
        3
      ]
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "edit",
        0
      ],
      "fps": [
        "edit_info",
        0
      ],
      "audio": [
        "source_frames",
        1
      ]
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "video",
        0
      ],
      "filename_prefix": "open_cinema/dub",
      "format": "mp4",
      "format.codec": "h264",
      "format.codec.encoding": "re-encode",
      "format.codec.encoding.crf": 16
    }
  }
}
