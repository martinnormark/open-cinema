{
  "source": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "source.mp4"
    }
  },
  "source_frames": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "source",
        0
      ]
    }
  },
  "source_size": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "source_frames",
        0
      ]
    }
  },
  "width": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(2, round(a * 1.3333333333333333 / 2) * 2)",
      "values.a": [
        "source_size",
        0
      ]
    }
  },
  "height": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(2, round(a / 2) * 2)",
      "values.a": [
        "source_size",
        1
      ]
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "result",
        0
      ],
      "fps": [
        "source_frames",
        2
      ],
      "audio": [
        "source_frames",
        1
      ]
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "video",
        0
      ],
      "filename_prefix": "open_cinema/square",
      "format": "mp4",
      "format.codec": "h264",
      "format.codec.encoding": "re-encode",
      "format.codec.encoding.crf": 16
    }
  },
  "result": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "source_frames",
        0
      ],
      "upscale_method": "bicubic",
      "width": [
        "width",
        1
      ],
      "height": [
        "height",
        1
      ],
      "crop": "disabled"
    }
  }
}
