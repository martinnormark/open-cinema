        "reference_0",
        0
      ],
      "ref_images.ref_image_1": [
        "reference_1",
        0
      ],
      "ref_videos.ref_video_0": [
        "source",
        0
      ],
      "ref_videos.ref_video_1": [
        "tracks_frames",
        0
