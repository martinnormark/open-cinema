        0
      ],
      "initial_mask": [
        "g150_masks",
        0
      ],
      "detection_threshold": 0.5,
      "max_objects": 1,
      "detect_interval": 1
    }
  },
  "g150_before_length": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "a + 1",
      "values.a": [
        "g150_index",
        1
