  },
  "p0_box_x": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(0, round(0.58 * a))",
      "values.a": [
        "work_size",
        0
      ]
    }
  },
  "p0_box_y": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(0, round(0.12 * a))",
      "values.a": [
        "work_size",
        1
      ]
    }
  },
  "p0_box_w": {
    "class_type": "ComfyMathExpression",
