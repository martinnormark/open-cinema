  "g150_behind": {
    "class_type": "ReverseImageBatch",
    "inputs": {
      "images": [
        "g150_before",
        0
      ]
    }
  },
  "g150_backward": {
    "class_type": "SAM3_VideoTrack",
    "inputs": {
      "images": [
        "g150_behind",
        0
