        0
      ],
      "initial_mask": [
        "g150_masks",
        0
      ],
      "detection_threshold": 0.5,
      "max_objects": 1,
      "detect_interval": 1
    }
  },
  "p0_forward": {
    "class_type": "SAM3_TrackToMask",
    "inputs": {
      "track_data": [
        "g150_forward",
        0
      ],
      "object_indices": "0"
    }
  },
  "p0_backward": {
    "class_type": "SAM3_TrackToMask",
    "inputs": {
      "track_data": [
        "g150_backward",
        0
      ],
      "object_indices": "0"
    }
  },
  "p0_forward_image": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": [
        "p0_forward",
        0
      ]
    }
  },
  "p0_backward_image": {
    "class_type": "MaskToImage",
    "inputs": {
      "mask": [
        "p0_backward",
        0
      ]
