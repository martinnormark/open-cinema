  "gen_width": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(32, round(a * min(1, sqrt(1032192 / (a * b))) / 32) * 32)",
      "values.a": [
        "source_size",
        0
      ],
      "values.b": [
        "source_size",
        1
      ]
    }
  },
  "gen_height": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(32, round(b * min(1, sqrt(1032192 / (a * b))) / 32) * 32)",
      "values.a": [
        "source_size",
        0
      ],
      "values.b": [
        "source_size",
        1
      ]
    }
  },
  "gen_length": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(124, a + (5 - a % 17) % 17)",
      "values.a": [
        "source_size",
        2
      ]
    }
  },
