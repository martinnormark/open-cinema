{
  "source": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "source.mp4"
    }
  },
  "source_frames": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "source",
        0
      ]
    }
  },
  "source_size": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "source_frames",
        0
      ]
    }
  },
  "frame_count": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(1, ((min(a, 121) - 1) // 8) * 8 + 1)",
      "values.a": [
        "source_size",
        2
      ]
    }
  },
  "matte_width": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(64, round(a * min(1, 960 / max(a, b)) / 32) * 32)",
      "values.a": [
        "source_size",
        0
      ],
      "values.b": [
        "source_size",
        1
      ]
    }
  },
  "matte_height": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(64, round(b * min(1, 960 / max(a, b)) / 32) * 32)",
      "values.a": [
        "source_size",
        0
      ],
      "values.b": [
        "source_size",
        1
      ]
    }
  },
  "clip": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "source_frames",
        0
      ],
      "batch_index": 0,
      "length": [
        "frame_count",
        1
      ]
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5-22b-distilled-transformer-bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "alpha_gen": {
    "class_type": "LTXICLoRALoaderModelOnly",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "lora_name": "ltx-2.5-22b-ic-lora-alpha-gen-0.9.safetensors",
      "strength_model": 1
    }
  },
  "text_encoder": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-bf16.safetensors",
      "type": "ltxv",
      "device": "default"
    }
  },
  "video_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
    }
  },
  "audio_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
    }
  },
  "positive_text": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "text_encoder",
        0
      ]
    }
  },
  "negative_text": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "text_encoder",
        0
      ]
    }
  },
  "conditioning": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": [
        "positive_text",
        0
      ],
      "negative": [
        "negative_text",
        0
      ],
      "frame_rate": [
        "source_frames",
        2
      ]
    }
  },
  "empty_video": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": [
        "matte_width",
        1
      ],
      "height": [
        "matte_height",
        1
      ],
      "length": [
        "frame_count",
        1
      ],
      "batch_size": 1
    }
  },
  "guide": {
    "class_type": "LTXAddVideoICLoRAGuide",
    "inputs": {
      "positive": [
        "conditioning",
        0
      ],
      "negative": [
        "conditioning",
        1
      ],
      "vae": [
        "video_vae",
        0
      ],
      "latent": [
        "empty_video",
        0
      ],
      "image": [
        "clip",
        0
      ],
      "frame_idx": 0,
      "strength": 1,
      "latent_downscale_factor": [
        "alpha_gen",
        1
      ],
      "crop": "disabled",
      "use_tiled_encode": false,
      "tile_size": 256,
      "tile_overlap": 64
    }
  },
  "empty_audio": {
    "class_type": "LTXVEmptyLatentAudio",
    "inputs": {
      "frames_number": [
        "frame_count",
        1
      ],
      "frame_rate": [
        "source_frames",
        2
      ],
      "batch_size": 1,
      "audio_vae": [
        "audio_vae",
        0
      ]
    }
  },
  "av_latent": {
    "class_type": "LTXVConcatAVLatent",
    "inputs": {
      "video_latent": [
        "guide",
        2
      ],
      "audio_latent": [
        "empty_audio",
        0
      ]
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 20261030
    }
  },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": [
        "alpha_gen",
        0
      ],
      "positive": [
        "guide",
        0
      ],
      "negative": [
        "guide",
        1
      ],
      "cfg": 1
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler_ancestral"
    }
  },
  "sigmas": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sigmas",
        0
      ],
      "latent_image": [
        "av_latent",
        0
      ]
    }
  },
  "separate": {
    "class_type": "LTXVSeparateAVLatent",
    "inputs": {
      "av_latent": [
        "sample",
        0
      ]
    }
  },
  "crop_guides": {
    "class_type": "LTXVCropGuides",
    "inputs": {
      "positive": [
        "guide",
        0
      ],
      "negative": [
        "guide",
        1
      ],
      "latent": [
        "separate",
        0
      ]
    }
  },
  "decode": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "crop_guides",
        2
      ],
      "vae": [
        "video_vae",
        0
      ],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "matte": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "decode",
        0
      ],
      "upscale_method": "bilinear",
      "width": [
        "source_size",
        0
      ],
      "height": [
        "source_size",
        1
      ],
      "crop": "disabled"
    }
  },
  "mask": {
    "class_type": "ImageToMask",
    "inputs": {
      "image": [
        "matte",
        0
      ],
      "channel": "red"
    }
  },
  "composite": {
    "class_type": "ImageCompositeMasked",
    "inputs": {
      "destination": [
        "background_repeat",
        0
      ],
      "source": [
        "clip",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "mask",
        0
      ]
    }
  },
  "composite_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "composite",
        0
      ],
      "fps": [
        "source_frames",
        2
      ],
      "audio": [
        "source_frames",
        1
      ]
    }
  },
  "save_composite": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "composite_video",
        0
      ],
      "filename_prefix": "open_cinema/alpha_composite",
      "format": "mp4",
      "format.codec": "h264"
    },
    "_meta": {
      "title": "Composite"
    }
  },
  "matte_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "matte",
        0
      ],
      "fps": [
        "source_frames",
        2
      ]
    }
  },
  "save_matte": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "matte_video",
        0
      ],
      "filename_prefix": "open_cinema/alpha_matte",
      "format": "mp4",
      "format.codec": "h264"
    },
    "_meta": {
      "title": "Matte"
    }
  },
  "background_image": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "background.jpg"
    }
  },
  "background_fit": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "background_image",
        0
      ],
      "upscale_method": "lanczos",
      "width": [
        "source_size",
        0
      ],
      "height": [
        "source_size",
        1
      ],
      "crop": "center"
    }
  },
  "background_repeat": {
    "class_type": "RepeatImageBatch",
    "inputs": {
      "image": [
        "background_fit",
        0
      ],
      "amount": [
        "frame_count",
        1
      ]
    }
  }
}
