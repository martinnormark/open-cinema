{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "r2_buckets": [
    {
      "binding": "GENERATED_ASSETS",
      "bucket_name": "open-cinema-generated-assets",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-cinema",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  "name": "open-cinema-web",
  "vars": {
    // "local" (loopback test sessions) or "cloudflare-access". See docs/auth.md.
    "AUTH_MODE": "local",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
  },
  "secrets": { "required": ["LOCAL_SESSION_SECRET", "LOCAL_MVP_ENABLED"] },
  "main": "@tanstack/react-start/server-entry",
  "durable_objects": {
    "bindings": [
      {
        "name": "GENERATION_COORDINATORS",
        "class_name": "GenerationCoordinator",
        "script_name": "open-cinema-jobs",
      },
    ],
  },
}
