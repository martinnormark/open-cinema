{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "r2_buckets": [
    {
      "binding": "GENERATED_ASSETS",
      "bucket_name": "open-cinema-generated-assets",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-cinema",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  "name": "open-cinema-jobs",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "GENERATION_COORDINATORS",
        "class_name": "GenerationCoordinator",
      },
      {
        "name": "MEDIA",
        "class_name": "MediaContainer",
      },
    ],
  },
  // ffmpeg steps no Router model offers: the background foreground lock and
  // frame-rate conform (media/server.mjs, docs/background-job.md).
  "containers": [
    {
      "class_name": "MediaContainer",
      "image": "./media/Dockerfile",
      "max_instances": 4,
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GenerationCoordinator"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MediaContainer"],
    },
  ],
  // Declared so `wrangler dev` loads them from .dev.vars: with `secrets.required`
  // set, only declared keys are read. Empty means "use the production default".
  "vars": {
    "COMFY_BASE_URL": "",
    "MEDIA_PUBLIC_ORIGIN": "",
    "MEDIA_ORIGIN": "",
  },
  // `wrangler dev` would otherwise need Docker; locally the media server runs
  // on its own and MEDIA_ORIGIN points at it (docs/background-job.md).
  "dev": { "enable_containers": false },
  "secrets": { "required": ["COMFY_API_KEY"] },
}
