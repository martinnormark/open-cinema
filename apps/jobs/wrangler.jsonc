{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "r2_buckets": [
    {
      "binding": "GENERATED_ASSETS",
      "bucket_name": "open-cinema-generated-assets",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-cinema",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  "name": "open-cinema-jobs",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "GENERATION_COORDINATORS",
        "class_name": "GenerationCoordinator",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GenerationCoordinator"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MediaContainer"],
    },
    // The ffmpeg media container is gone: posters and square-pixel conversion
    // run in the browser, the background lock on Comfy Cloud.
    {
      "tag": "v3",
      "deleted_classes": ["MediaContainer"],
    },
  ],
  // Declared so `wrangler dev` loads them from .dev.vars: with `secrets.required`
  // set, only declared keys are read. Empty means "use the production default".
  "vars": {
    "COMFY_BASE_URL": "",
    "MEDIA_PUBLIC_ORIGIN": "",
    // Jobs one creator may run at Router or Comfy Cloud at once (1 to 4).
    // Empty means one: a second job waits until the first finishes.
    "MAX_ACTIVE_JOBS": "",
  },
  "secrets": { "required": ["COMFY_API_KEY"] },
}
