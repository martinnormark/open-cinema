# Copy to .dev.vars to enable Comfy Router generation.
# No credentials are needed for the scaffold or integration tests.
COMFY_API_KEY=""

# Development only. In an environment whose HTTPS proxy injects Comfy
# credentials (workerd bypasses HTTPS_PROXY), run `bun scripts/comfy-relay.ts`
# and point the jobs Worker at it. Set COMFY_API_KEY to any non-empty
# placeholder; the relay drops it. Ignored unless it is http on loopback.
# COMFY_BASE_URL="http://127.0.0.1:8790"

# Optional: provider-fetchable links for uploaded media (see docs/foundation.md).
# MEDIA_PUBLIC_ORIGIN="https://studio.example.com"
# The signing secret is production-only: `wrangler secret put MEDIA_SIGNING_SECRET`
# with the web Worker's LOCAL_SESSION_SECRET. .dev.vars does not load it.

# Development only: the media server that locks and conforms background
# replacements (docs/background-job.md). `wrangler dev` does not run the
# container; start `node apps/jobs/media/server.mjs` or the Docker image.
# MEDIA_ORIGIN="http://127.0.0.1:8080"

# Jobs one creator may run at Router or Comfy Cloud at once, 1 to 4. Unset
# means one, so a recast waits behind a background job. Raising it spends
# credits faster. Set it in production under the Worker's variables.
# MAX_ACTIVE_JOBS="2"
